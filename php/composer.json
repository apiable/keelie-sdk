{
    "name": "apiable/keelie-sdk",
    "description": "The Keelie SDK, by Apiable. In development, not released.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "keelie",
        "apiable",
        "psr-15",
        "middleware",
        "jwt",
        "oauth",
        "mcp"
    ],
    "homepage": "https://github.com/apiable/keelie-sdk/tree/main/php#readme",
    "authors": [
        {
            "name": "Apiable Oy",
            "homepage": "https://apiable.io"
        }
    ],
    "support": {
        "issues": "https://github.com/apiable/keelie-sdk/issues",
        "source": "https://github.com/apiable/keelie-sdk",
        "security": "https://github.com/apiable/keelie-sdk/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-openssl": "*",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Keelie\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keelie\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
