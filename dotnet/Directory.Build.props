<Project>
  <!-- Every project here: both LTS versions of .NET, nullable checks, and warnings as errors. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Each project's lock file pins every package, the transitive ones too. CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Apiable Oy</Authors>
    <Company>Apiable Oy</Company>
    <Copyright>Copyright 2026 Apiable Oy</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/apiable/keelie-sdk/tree/main/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apiable/keelie-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.0.1</Version>
  </PropertyGroup>
</Project>
