{
  "name": "keelie",
  "version": "0.0.2",
  "description": "The Keelie SDK, by Apiable. In development, not released.",
  "license": "Apache-2.0",
  "author": "Apiable Oy",
  "homepage": "https://github.com/apiable/keelie-sdk/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apiable/keelie-sdk.git",
    "directory": "node"
  },
  "bugs": "https://github.com/apiable/keelie-sdk/issues",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test --test-reporter=spec \".test-build/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "express": "5.3.0",
    "express4": "npm:express@4.22.3",
    "typescript": "6.0.3"
  }
}
